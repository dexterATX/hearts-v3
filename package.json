{
  "name": "hearts",
  "version": "3.0.0",
  "private": true,
  "description": "a private app for exactly two people — Scotty & Annsleigh",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor@latest",
    "db:types": "supabase gen types typescript --linked --schema public > lib/db/database.types.ts",
    "db:push": "supabase db push",
    "functions:deploy": "supabase functions deploy notify && supabase functions deploy ai-companion"
  },
  "dependencies": {
    "@react-native-community/netinfo": "12.0.1",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.111.0",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.9",
    "expo-asset": "~57.0.8",
    "expo-audio": "~57.0.3",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.8",
    "expo-crypto": "~57.0.1",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-picker": "~57.0.7",
    "expo-linking": "~57.0.4",
    "expo-local-authentication": "~57.0.2",
    "expo-media-library": "~57.0.3",
    "expo-notifications": "~57.0.8",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-video": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "tus-js-client": "^4.3.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.5",
    "eas-cli": "^21.4.0",
    "supabase": "^2.110.0",
    "typescript": "~6.0.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "tus-js-client"
        ]
      }
    }
  }
}
