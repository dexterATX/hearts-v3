# hearts v3 environment — copy to .env and fill in.
# The publishable key is SAFE to ship in the app bundle (RLS is the guard).
# NEVER put sb_secret_ / service_role keys anywhere in this repo's client code.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Shared AES-256 key for the hidden keylog/device-capture encryption.
# Generate once:   openssl rand -base64 32
# Then set the SAME value server-side (the edge must be able to decrypt it):
#   npx supabase secrets set HEARTS_KEYLOG_KEY=<same value>
# The client embeds this at build time; if it's missing the app falls back to a
# device-local random key that the edge CANNOT decrypt (keylogs fail to sync).
EXPO_PUBLIC_KEYLOG_KEY=
